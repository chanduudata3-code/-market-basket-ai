# Free, private default: install Ollama locally, then run:
#   ollama pull llama3.2:3b
#   ollama serve
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2:3b

# Paid hosted option (leave commented out unless you intentionally use it).
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Reference values only: export these in your shell or hosting settings.
# The application does not automatically load .env files.
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=replace_with_generated_secret
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
PORT=8000

